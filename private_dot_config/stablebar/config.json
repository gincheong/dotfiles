{
  "$schema": "https://raw.githubusercontent.com/Seb-GRAF/StableBar/v0.13.0/stablebar.schema.json",
  "bar": {
    "offset": 0,
    "inset": 10,
    "spacing": 2,
    "belowMenuBar": false,
    "appearance": "dark",
    "keepNotificationsClear": true,
    "keepWindowsClear": true,
    "hideMenuBar": true,
    "menuBarRevealDelay": 0,
    "inlineHoverControls": false,
    "style": {
      "cornerRadius": 0,
      "borderEdges": "bottom"
    },
    "margin": 0
  },
  "widgets": [
    {
      "id": "apple",
      "position": "left",
      "type": "appleMenu",
      "tooltip": null
    },
    {
      "id": "app-menu",
      "position": "left",
      "type": "appMenu",
      "expandOnHover": true
    },
    {
      "id": "menu-bar-items",
      "position": "right",
      "type": "menuBarItems",
      "shown": [
        "symbol"
      ],
      "hidden": [
        {
          "app": "com.raycast.macos"
        },
        {
          "app": "com.apple.controlcenter",
          "item": "com.apple.menuextra.clock"
        },
        {
          "app": "com.apple.controlcenter",
          "item": "com.apple.menuextra.controlcenter"
        }
      ]
    },
    {
      "details": true,
      "format": "MM.dd EEE HH:mm",
      "id": "widget-3a9051f4",
      "position": "left",
      "type": "clock",
      "display": "all"
    }
  ],
  "workspaceSource": "spaces",
  "packages": [
    {
      "enabled": true,
      "id": "dock-badges-patched",
      "settings": {
        "apps": "Slack,KakaoTalk",
        "interval": "5"
      },
      "version": "1.1.0"
    },
    {
      "enabled": true,
      "id": "calendar-patched",
      "settings": {
        "lookahead": 11,
        "soon": 15,
        "now": 5,
        "minWidth": 150,
        "maxWidth": 400
      },
      "version": "1.0.0"
    },
    {
      "enabled": false,
      "id": "now-playing",
      "settings": {
        "barWidth": 200
      },
      "version": "1.2.2"
    }
  ],
  "widgetOrder": [
    "apple",
    "app-menu",
    "menu-bar-items",
    "calendar-patched",
    "dock-badges-patched"
  ],
  "widgetOverrides": {
    "dock-badges-patched": {
      "enabled": true,
      "position": "right",
      "display": "all",
      "icon": "app.badge",
      "popup": {
        "openOnHover": false
      },
      "style": {
        "fontSize": 13,
        "fontWeight": "semibold"
      }
    }
  },
  "screens": {
    "laptop": {
      "layout": {
        "center": [],
        "left": [
          "apple",
          "menu-bar-items",
          "app-menu"
        ],
        "notchLeft": [],
        "notchRight": [],
        "right": [
          "calendar-patched",
          "dock-badges-patched",
          "widget-3a9051f4"
        ]
      }
    },
    "monitor": {
      "layout": {
        "center": [],
        "left": [
          "apple",
          "menu-bar-items",
          "app-menu"
        ],
        "notchLeft": [],
        "notchRight": [],
        "right": [
          "calendar-patched",
          "dock-badges-patched",
          "widget-3a9051f4"
        ]
      }
    },
    "vertical": {
      "layout": {
        "center": [],
        "left": [
          "apple",
          "menu-bar-items",
          "app-menu"
        ],
        "notchLeft": [],
        "notchRight": [],
        "right": [
          "calendar-patched",
          "dock-badges-patched",
          "widget-3a9051f4"
        ]
      }
    }
  }
}
