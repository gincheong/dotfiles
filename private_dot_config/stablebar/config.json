{
  "$schema": "https://raw.githubusercontent.com/Seb-GRAF/StableBar/v0.13.0/stablebar.schema.json",
  "bar": {
    "height": 40,
    "offset": 0,
    "inset": 12,
    "spacing": 8,
    "belowMenuBar": false,
    "appearance": "dark",
    "keepNotificationsClear": false,
    "keepWindowsClear": true,
    "hideMenuBar": true,
    "menuBarRevealDelay": 0,
    "inlineHoverControls": false
  },
  "widgets": [
    {
      "id": "apple",
      "position": "left",
      "type": "appleMenu"
    },
    {
      "id": "app-menu",
      "position": "left",
      "type": "appMenu",
      "expandOnHover": true
    },
    {
      "id": "sound",
      "type": "audio",
      "position": "right",
      "layout": {
        "children": [
          {
            "type": "symbol",
            "source": "icon"
          },
          {
            "field": "text",
            "type": "field"
          }
        ],
        "type": "row"
      }
    },
    {
      "format": "MM.dd E HH:mm",
      "id": "clock",
      "onClick": "open -a Calendar",
      "position": "right",
      "type": "clock",
      "icon": "",
      "details": false
    },
    {
      "id": "menu-bar-items",
      "position": "right",
      "type": "menuBarItems",
      "shown": [
        "symbol"
      ],
      "hidden": [
        {
          "app": "com.raycast.macos"
        },
        {
          "app": "com.apple.controlcenter",
          "item": "com.apple.menuextra.clock"
        },
        {
          "app": "com.apple.controlcenter",
          "item": "com.apple.menuextra.controlcenter"
        }
      ]
    },
    {
      "details": true,
      "id": "widget-4f91238a",
      "position": "right",
      "type": "battery",
      "display": "all",
      "layout": {
        "children": [
          {
            "type": "battery"
          },
          {
            "field": "text",
            "type": "field"
          }
        ],
        "type": "row"
      }
    }
  ],
  "workspaceSource": "spaces",
  "packages": [
    {
      "enabled": true,
      "id": "dock-badges-patched",
      "settings": {
        "apps": "Slack,KakaoTalk,Mail"
      },
      "version": "1.1.0"
    },
    {
      "enabled": true,
      "id": "now-playing",
      "settings": {
        "barWidth": 200
      },
      "version": "1.2.2"
    }
  ],
  "widgetOrder": [
    "apple",
    "app-menu",
    "now-playing",
    "sound",
    "clock",
    "menu-bar-items",
    "dock-badges-patched",
    "widget-4f91238a"
  ],
  "widgetOverrides": {
    "now-playing": {
      "enabled": true,
      "position": "right",
      "display": "all",
      "icon": ""
    },
    "dock-badges-patched": {
      "enabled": true,
      "position": "right",
      "display": "all",
      "icon": "app.badge",
      "popup": {
        "openOnHover": false
      }
    }
  },
  "screens": {
    "laptop": {
      "layout": {
        "center": [],
        "left": [
          "apple",
          "app-menu",
          "now-playing"
        ],
        "notchLeft": [],
        "notchRight": [],
        "right": [
          "clock",
          "dock-badges-patched",
          "sound",
          "widget-4f91238a",
          "menu-bar-items"
        ]
      }
    },
    "monitor": {
      "layout": {
        "center": [],
        "left": [
          "apple",
          "app-menu",
          "now-playing"
        ],
        "notchLeft": [],
        "notchRight": [],
        "right": [
          "clock",
          "dock-badges-patched",
          "sound",
          "widget-4f91238a",
          "menu-bar-items"
        ]
      }
    },
    "vertical": {
      "layout": {
        "center": [],
        "left": [
          "apple",
          "app-menu",
          "now-playing"
        ],
        "notchLeft": [],
        "notchRight": [],
        "right": [
          "clock",
          "dock-badges-patched",
          "sound",
          "widget-4f91238a",
          "menu-bar-items"
        ]
      }
    }
  }
}
