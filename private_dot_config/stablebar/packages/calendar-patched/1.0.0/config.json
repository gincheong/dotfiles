{
  "providers": {
    "calendar": {
      "type": "calendar",
      "calendars": ["@setting.calendar1", "@setting.calendar2", "@setting.calendar3", "@setting.calendar4"],
      "lookahead": "@setting.lookahead",
      "soon": "@setting.soon",
      "now": "@setting.now"
    }
  },
  "widgets": [
    {
      "id": "calendar-patched",
      "type": "calendar",
      "position": "right",
      "details": true,
      "style": {
        "fontSize": 13,
        "minWidth": "@setting.minWidth",
        "maxWidth": "@setting.maxWidth"
      }
    }
  ]
}
