{
  "$schema": "https://raw.githubusercontent.com/Seb-GRAF/StableBar/v0.14.0/stablebar.schema.json",
  "bar": {
    "offset": 0,
    "inset": 10,
    "spacing": 2,
    "belowMenuBar": false,
    "appearance": null,
    "keepNotificationsClear": true,
    "keepWindowsClear": true,
    "hideMenuBar": true,
    "menuBarRevealDelay": 0,
    "style": {
      "cornerRadius": 12
    },
    "margin": 0
  },
  "widgets": [
    {
      "id": "apple",
      "position": "left",
      "type": "appleMenu",
      "tooltip": null
    },
    {
      "id": "app-menu",
      "position": "left",
      "type": "appMenu",
      "expandOnHover": true,
      "style": {
        "paddingHorizontal": 4
      }
    },
    {
      "id": "menu-bar-items",
      "position": "right",
      "type": "menuBarItems",
      "shown": [
        "symbol"
      ],
      "hidden": [
        {
          "app": "com.raycast.macos"
        },
        {
          "app": "com.kakao.KakaoTalkMac"
        },
        {
          "app": "com.apple.controlcenter",
          "item": "com.apple.menuextra.clock"
        },
        {
          "app": "com.xiaogd.Doll"
        }
      ],
      "icon": "ellipsis",
      "style": {
        "paddingHorizontal": 4
      }
    },
    {
      "details": true,
      "format": "MM.dd EEE HH:mm",
      "id": "widget-3a9051f4",
      "position": "left",
      "type": "clock",
      "display": "all",
      "style": {
        "paddingHorizontal": 9
      }
    },
    {
      "id": "widget-528e3ca7",
      "position": "right",
      "type": "privacy",
      "display": "all",
      "hideWhenIdle": true,
      "icon": "",
      "style": {
        "paddingHorizontal": 8
      }
    }
  ],
  "workspaceSource": "spaces",
  "packages": [
    {
      "enabled": true,
      "id": "dock-badges-patched",
      "settings": {
        "apps": "Slack,KakaoTalk",
        "interval": "5"
      },
      "version": "1.1.0"
    },
    {
      "enabled": true,
      "id": "calendar-patched",
      "settings": {
        "lookahead": 11,
        "soon": 15,
        "now": 5,
        "minWidth": 150,
        "maxWidth": 400,
        "calendar1": "{{ .stablebar_calendar_1 }}",
        "calendar2": "{{ .stablebar_calendar_2 }}",
        "calendar3": "",
        "calendar4": ""
      },
      "version": "1.0.0"
    },
    {
      "enabled": false,
      "id": "now-playing",
      "settings": {
        "barWidth": 200
      },
      "version": "1.2.2"
    }
  ],
  "widgetOrder": [
    "apple",
    "app-menu",
    "menu-bar-items",
    "calendar-patched",
    "dock-badges-patched"
  ],
  "widgetOverrides": {
    "dock-badges-patched": {
      "enabled": true,
      "position": "right",
      "display": "all",
      "icon": "app.badge",
      "popup": {
        "openOnHover": false
      },
      "style": {
        "fontSize": 13,
        "fontWeight": "semibold",
        "paddingHorizontal": 4
      }
    },
    "calendar-patched": {
      "style": {
        "paddingHorizontal": 8
      }
    }
  },
  "screens": {
    "laptop": {
      "layout": {
        "center": [],
        "left": [
          "apple",
          "app-menu"
        ],
        "notchLeft": [],
        "notchRight": [],
        "right": [
          "calendar-patched",
          "dock-badges-patched",
          "menu-bar-items",
          "widget-3a9051f4",
          "widget-528e3ca7"
        ]
      }
    },
    "monitor": {
      "layout": {
        "center": [],
        "left": [
          "apple",
          "app-menu"
        ],
        "notchLeft": [],
        "notchRight": [],
        "right": [
          "calendar-patched",
          "dock-badges-patched",
          "menu-bar-items",
          "widget-3a9051f4",
          "widget-528e3ca7"
        ]
      }
    },
    "vertical": {
      "layout": {
        "center": [],
        "left": [
          "apple",
          "app-menu"
        ],
        "notchLeft": [],
        "notchRight": [],
        "right": [
          "calendar-patched",
          "dock-badges-patched",
          "menu-bar-items",
          "widget-3a9051f4",
          "widget-528e3ca7"
        ]
      }
    }
  },
  "profiles": [
    {
      "configuration": {},
      "enabled": false,
      "name": "1"
    }
  ],
  "theme": {
    "id": "notch"
  }
}
